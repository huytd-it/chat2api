{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f 'C:\\Users\\tdhuy\\.agents\\skills\\impeccable\\scripts\\hook.mjs' ] || node 'C:\\Users\\tdhuy\\.agents\\skills\\impeccable\\scripts\\hook.mjs'",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if (Test-Path -LiteralPath \"$env:USERPROFILE/.agents/skills/impeccable/scripts/hook.mjs\") { & node \"$env:USERPROFILE/.agents/skills/impeccable/scripts/hook.mjs\"; exit $LASTEXITCODE }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f 'C:\\Users\\tdhuy\\.agents\\skills\\impeccable\\scripts\\hook.mjs' ] || node 'C:\\Users\\tdhuy\\.agents\\skills\\impeccable\\scripts\\hook.mjs'",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "if (Test-Path -LiteralPath \"$env:USERPROFILE/.agents/skills/impeccable/scripts/hook.mjs\") { & node \"$env:USERPROFILE/.agents/skills/impeccable/scripts/hook.mjs\"; exit $LASTEXITCODE }"
          }
        ]
      }
    ]
  }
}
