# =========================================================
#  chat2api — example env
# =========================================================
# Copy sang `.env` rồi sửa theo môi trường của bạn:
#     cp .env.example .env
#
# Thứ tự ưu tiên khi đọc một khoá (docs/design-v2.md §2):
#   1. môi trường thật / `.env`  — chốt cứng, thắng mọi thứ khác
#   2. bảng `setting` trong SQLite (đổi qua trang Settings trong app)
#   3. giá trị `default` khai báo dưới đây
#
# Khoá nào chưa cần thiết thì để trống hoặc bỏ comment — app dùng default.
# Không commit `.env` (đã nằm trong .gitignore).

# ------------------------------------------------------------------
#  Serve (backend)
# ------------------------------------------------------------------
# Host/port của `python -m chat2api serve`. App desktop tự spawn sidecar
# này (desktop/src-tauri/src/lib.rs): CHAT2API_PORT đọc từ .env là cách
# pin port bền vững cho .exe — mở app lần nào cũng dùng đúng port.
# Để trống -> sidecar tự chọn port trống. Port bị chiếm hoặc nằm trong
# dải Windows-reserved (Hyper-V/WSL) sẽ tự bỏ qua và chọn port khác.
CHAT2API_PORT=8100

# Thư mục dữ liệu chung: SQLite (chat2api.db), profile Chromium, blob.
# Sidecar desktop luôn đặt workdir = repo root, nên default "./data" trỏ
# đúng tới data/ của repo. Đổi tới nơi khác nếu muốn tách dữ liệu.
CHAT2API_DATA_DIR=./data

# Thư mục chứa các recipe (gemini/, openai/, ... + recipe.yaml).
RECIPES_DIR=./recipes

# ------------------------------------------------------------------
#  Desktop sidecar (.exe) — chỉ dùng cho bản desktop
# ------------------------------------------------------------------
# Workdir cho tiến trình Python sidecar. Script build
# (scripts/build-desktop.ps1) tự đặt = repo root; chỉ cần đổi khi cài
# bundle độc lập (không có repo checkout).
# CHAT2API_WORKDIR=

# Python interpreter dùng để chạy sidecar. Mặc định "python" (lấy từ PATH).
# Trỏ tới venv cụ thể nếu `python` không phải interpreter bạn muốn:
# CHAT2API_PYTHON=C:\path\to\venv\Scripts\python.exe

# ------------------------------------------------------------------
#  Authentication (API keys)
# ------------------------------------------------------------------
# Danh sách key bootstrap (phân cách bằng dấu phẩy). Để trống = không yêu
# cầu key. Có thể quản lý key chi tiết hơn qua trang Settings (bảng api_key).
# CHAT2API_KEYS=key1,key2

# ------------------------------------------------------------------
#  Browser / pool (đổi qua Settings; cần restart server)
# ------------------------------------------------------------------
# Engine browser: playwright | cloak
# BROWSER_ENGINE=playwright
# Chế độ danh tính trình duyệt: storage_state | profile
# BROWSER_PROFILE_MODE=storage_state
# Số browser context tối đa (chế độ storage_state)
# POOL_MAX_CONTEXTS=3
# Số profile Chromium mở cùng lúc (chế độ profile)
# POOL_MAX_PROFILES=6
# Số tab tối đa trong một profile
# PROFILE_MAX_TABS=8

# ------------------------------------------------------------------
#  API / routing (đổi qua Settings; hiệu lực sau khi reload recipe)
# ------------------------------------------------------------------
# Cách chọn account cho request không kèm X-Chat2api-Account-Id:
# least_busy | round_robin | sticky_session | off
# API_ACCOUNT_STRATEGY=least_busy
# Số request song song trên một account
# API_MAX_CONCURRENT_PER_ACCOUNT=1
# Trần request chat song song (0 = không giới hạn)
# API_MAX_CONCURRENT_REQUESTS=0
# Hiện cửa sổ browser cho request API: auto | always | never
# API_HEADED=auto
# Gom request thành session: per_request | client_window
# API_SESSION_MODE=per_request

# ------------------------------------------------------------------
#  Agent / fallback (đổi qua Settings; cần restart server)
# ------------------------------------------------------------------
# Bật agent fallback khi recipe hỏng
# ENABLE_AGENT_FALLBACK=false
# Số vòng thử tối đa khi Integrate
# INTEGRATE_MAX_ROUNDS=5
# LLM dùng cho agent fallback / integrate
# AGENT_LLM_BASE_URL=
# AGENT_LLM_MODEL=
# AGENT_LLM_API_KEY=

# ------------------------------------------------------------------
#  Server misc
# ------------------------------------------------------------------
# Hạn chờ recipe trả lời (ms)
# RECIPE_TIMEOUT_MS=120000
# Số lượt dùng thử ẩn danh (0 = không giới hạn)
# ANON_TRIAL_LIMIT=20

# ------------------------------------------------------------------
#  Browser timing (đổi qua Settings; hiệu lực sau khi reload recipe)
# ------------------------------------------------------------------
# Delay chờ web sẵn sàng (ms)
# RECIPE_READY_DELAY_MS=1200
# Delay trước khi nhập prompt (ms)
# RECIPE_INPUT_DELAY_MS=400
# Hạn chờ ô input xuất hiện (ms)
# RECIPE_READY_TIMEOUT_MS=20000
